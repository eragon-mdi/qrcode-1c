// Генерация QR-кодов через внешнюю компоненту QRCode1C (qrcode1c.dll).
// Платформа 1С:Предприятие 8.1, обычное приложение, код выполняется на клиенте.
//
// DLL хранится в макете «QRCode1CDLL» (тип «Двоичные данные»). При первом обращении в сеансе
// она выгружается во временный каталог пользователя и регистрируется в HKCU:
// права администратора и установка на рабочие места не нужны.
//
// Куда вставлять:
//   - модуль внешней обработки + макет обработки QRCode1CDLL — для проверки без изменения конфигурации;
//   - общий модуль (флаг «Клиент») + общий макет QRCode1CDLL — в конфигурацию.
// Отличается только функция ДанныеКомпоненты().

// Версия DLL в макете. При замене макета увеличьте её — файл выгрузится под новым именем
// и не будет конфликтовать со старым, который может держать открытым другой сеанс 1С.
Функция ВерсияКомпоненты()
	Возврат "1.0.0";
КонецФункции

Функция ДанныеКомпоненты()
	// Внешняя обработка:
	Возврат ПолучитьМакет("QRCode1CDLL");
	// Общий модуль конфигурации:
	// Возврат ПолучитьОбщийМакет("QRCode1CDLL");
КонецФункции

// Возвращает объект компоненты AddIn.QRCode1C, при необходимости выгружая и подключая DLL.
Функция ПолучитьКомпоненту() Экспорт

	Компонента = СоздатьОбъектКомпоненты();
	Если Компонента <> Неопределено Тогда
		Возврат Компонента;
	КонецЕсли;

	Каталог = КаталогВременныхФайлов();
	Если Прав(Каталог, 1) <> "\" Тогда
		Каталог = Каталог + "\";
	КонецЕсли;
	ИмяФайла = Каталог + "qrcode1c_" + СтрЗаменить(ВерсияКомпоненты(), ".", "_") + ".dll";

	// Файл этой версии мог остаться от прошлых сеансов или быть открыт другим сеансом 1С.
	Если НайтиФайлы(ИмяФайла).Количество() = 0 Тогда
		ДанныеКомпоненты().Записать(ИмяФайла);
	КонецЕсли;

	ТекстОшибки = "";
	Компонента = ПодключитьИзФайла(ИмяФайла, ТекстОшибки);
	Если Компонента = Неопределено Тогда
		// Файл мог остаться битым после прерванной записи: выгружаем заново и пробуем ещё раз.
		Попытка
			УдалитьФайлы(ИмяФайла);
			ДанныеКомпоненты().Записать(ИмяФайла);
		Исключение
		КонецПопытки;
		Компонента = ПодключитьИзФайла(ИмяФайла, ТекстОшибки);
	КонецЕсли;

	Если Компонента = Неопределено Тогда
		ВызватьИсключение "Не удалось подключить компоненту QR-кодов " + ИмяФайла + ". " + ТекстОшибки;
	КонецЕсли;
	Возврат Компонента;

КонецФункции

Функция СоздатьОбъектКомпоненты()
	Попытка
		Возврат Новый("AddIn.QRCode1C");
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Регистрирует и подключает DLL. Возвращает объект компоненты или Неопределено.
Функция ПодключитьИзФайла(ИмяФайла, ТекстОшибки)

	Попытка
		ЗагрузитьВнешнююКомпоненту(ИмяФайла);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;
	Компонента = СоздатьОбъектКомпоненты();

	Если Компонента = Неопределено Тогда
		// Запасной путь: DLL зарегистрировалась, но по имени файла не подключилась.
		Попытка
			ПодключитьВнешнююКомпоненту("AddIn.QRCode1C");
		Исключение
			ТекстОшибки = ОписаниеОшибки();
		КонецПопытки;
		Компонента = СоздатьОбъектКомпоненты();
	КонецЕсли;

	Возврат Компонента;

КонецФункции

// Возвращает Картинку с QR-кодом для строки Текст.
//   РазмерМодуля     — пикселей на один «квадратик» QR-кода;
//   Поле             — белая рамка в модулях (по стандарту не меньше 4);
//   УровеньКоррекции — "L", "M", "Q" или "H": QR читается при повреждении 7/15/25/30% площади;
//   Кодировка        — "UTF-8" (QR на оплату по ГОСТ Р 56042: префикс ST00012)
//                      или "windows-1251" (префикс ST00011).
Функция КартинкаQR(Текст, РазмерМодуля = 4, Поле = 4, УровеньКоррекции = "M", Кодировка = "UTF-8") Экспорт

	Компонента = ПолучитьКомпоненту();
	Компонента.Кодировка = Кодировка;

	ИмяФайла = ПолучитьИмяВременногоФайла("png");
	Если Не Компонента.СформироватьPNG(Текст, ИмяФайла, РазмерМодуля, Поле, УровеньКоррекции) Тогда
		ВызватьИсключение "Не удалось сформировать QR-код: " + Компонента.ОписаниеОшибки;
	КонецЕсли;

	Картинка = Новый Картинка(ИмяФайла);
	Попытка
		УдалитьФайлы(ИмяФайла);
	Исключение
		// Не критично: временный каталог чистит система.
	КонецПопытки;
	Возврат Картинка;

КонецФункции

// Проверка: открывает табличный документ с QR-кодом, его можно считать камерой телефона.
Процедура ПоказатьПример(Знач Текст = "") Экспорт

	Если ПустаяСтрока(Текст) Тогда
		Текст = "Проверка QR-кода из 1С:Предприятия 8.1, " + Формат(ТекущаяДата(), "ДФ='dd.MM.yyyy HH:mm:ss'");
	КонецЕсли;

	ТабДок = Новый ТабличныйДокумент;
	ТабДок.Область("R1C1").Текст = "Компонента QRCode1C " + ПолучитьКомпоненту().Версия;
	ТабДок.Область("R2C1").Текст = Текст;

	Рисунок = ТабДок.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Картинка);
	Рисунок.Картинка = КартинкаQR(Текст);
	Рисунок.РазмерКартинки = РазмерКартинки.Пропорционально;
	Рисунок.Лево = 10;
	Рисунок.Верх = 20;
	Рисунок.Ширина = 50;
	Рисунок.Высота = 50;

	ТабДок.Показать("QR-код");

КонецПроцедуры

